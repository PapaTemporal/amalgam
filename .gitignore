node_modules/
*.log

# Code graph (derived, per-machine)
graphify-out/

# Local agent wiring — generated by `amalgam wire` for one machine.
# Kept out of git so a clone never inherits someone else's absolute paths,
# and so the skills have a single source of truth in skills/.
.claude/
.mcp.json
.vscode/mcp.json
.github/copilot-instructions.md

# UI: source and the compiled output are both committed, so `amalgam ui` works
# straight from a clone. Only the toolchain's own artefacts are ignored.
ui/node_modules/
ui/.svelte-kit/
